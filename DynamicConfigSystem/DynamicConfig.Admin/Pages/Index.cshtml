@page
@model DynamicConfig.Admin.Pages.IndexModel

<a asp-page="Create" class="btn btn-primary mb-3">
    Add Configuration
</a>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input asp-for="ApplicationName"
                   class="form-control"
                   placeholder="Application Name" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </div>
</form>

<div class="mb-3">
    <input type="text"
           id="searchInput"
           class="form-control"
           placeholder="Search by name..." />
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Value</th>
            <th>Application</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody id="configTable">
        @foreach (var item in Model.Configurations)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Type</td>
                <td>@item.Value</td>
                <td>@item.ApplicationName</td>
                <td>@item.IsActive</td>
                <td>
                    <a asp-page="Edit"
                       asp-route-applicationName="@item.ApplicationName"
                       asp-route-name="@item.Name"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>